+{% extends "base.html" %}
+{% block titulo %}Usuarios — Verificador API{% endblock %}
+{% block contenido %}
+<div class="flex items-center justify-between mb-6">
+    <h1 class="text-2xl font-bold">Usuarios</h1>
+</div>
+
+<div class="overflow-x-auto">
+<table class="w-full text-sm border border-slate-200 dark:border-slate-800 rounded-lg overflow-hidden">
+    <thead class="bg-slate-100 dark:bg-slate-800">
+        <tr>
+            <th class="text-left px-3 py-2">Nombre</th>
+            <th class="text-left px-3 py-2">Email</th>
+            <th class="text-left px-3 py-2">Rol</th>
+            <th class="text-left px-3 py-2">Estado</th>
+            <th class="text-left px-3 py-2">Colecciones</th>
+            <th class="px-3 py-2"></th>
+        </tr>
+    </thead>
+    <tbody class="bg-white dark:bg-slate-900">
+        {% for u in usuarios %}
+        <tr class="border-t border-slate-100 dark:border-slate-800">
+            <td class="px-3 py-2">
+                {{ u.nombre }}
+                {% if u.id == usuario.id %}<span class="text-xs text-slate-400">(vos)</span>{% endif %}
+            </td>
+            <td class="px-3 py-2 font-mono">{{ u.email }}</td>
+            <td class="px-3 py-2">{{ u.rol }}</td>
+            <td class="px-3 py-2">
+                {% if u.activo %}
+                <span class="text-emerald-600 dark:text-emerald-400">Activo</span>
+                {% else %}
+                <span class="text-rose-600 dark:text-rose-400">Suspendido</span>
+                {% endif %}
+            </td>
+            <td class="px-3 py-2">{{ u.colecciones|length }}</td>
+            <td class="px-3 py-2 text-right whitespace-nowrap">
+                {% if u.id == usuario.id %}
+                <span class="text-xs text-slate-400">—</span>
+                {% else %}
+                    {% if u.activo %}
+                    <form method="post" action="/admin/usuarios/{{ u.id }}/suspender" class="inline">
+                        <button type="submit" class="text-amber-600 hover:underline text-xs">Suspender</button>
+                    </form>
+                    {% else %}
+                    <form method="post" action="/admin/usuarios/{{ u.id }}/reactivar" class="inline">
+                        <button type="submit" class="text-emerald-600 hover:underline text-xs">Reactivar</button>
+                    </form>
+                    {% endif %}
+                    <form method="post" action="/admin/usuarios/{{ u.id }}/eliminar" class="inline ml-3">
+                        <button type="submit" class="text-rose-500 hover:underline text-xs">Eliminar</button>
+                    </form>
+                {% endif %}
+            </td>
+        </tr>
+        {% endfor %}
+    </tbody>
+</table>
+</div>
+{% endblock %}
