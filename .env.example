# Copia este archivo como .env y completa los valores.
# El .env está en .gitignore y no debe subirse nunca al repositorio.

# --- Conexión a MySQL ----------------------------------------------------
# Los datos los entrega el panel del proveedor al crear el servicio.
# Aiven exige TLS, así que DB_SSL debe quedar en true.
DB_HOST=tu-servicio.aivencloud.com
DB_PORT=12345
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_NAME=defaultdb
DB_SSL=true

# Certificado de la autoridad certificadora, opcional.
# Sin él la conexión sigue cifrada, pero no se verifica la identidad del
# servidor. Para trabajar con datos reales conviene descargarlo del panel
# del proveedor y apuntar aquí su ruta.
DB_SSL_CA=

# --- Carga ---------------------------------------------------------------
# Filas por lote al insertar. Subirlo acelera la carga pero consume más
# memoria en el servidor; 5000 es un punto razonable.
LOTE_INSERCION=5000

# --- Encendido automático (opcional) --------------------------------------
# El plan gratuito de Aiven apaga el servicio tras un periodo sin uso.
# Si completas estas tres variables, el proyecto lo enciende solo antes
# de conectar y espera a que quede listo. Sin ellas, hay que encenderlo
# a mano desde el panel cuando esté apagado; el resto funciona igual.
#
# El token se genera en el panel de Aiven: tu usuario (arriba a la
# derecha) > Personal tokens > Generate token. Trátalo como una
# contraseña: da acceso a administrar tus servicios.
AIVEN_API_TOKEN=
AIVEN_PROJECT_NAME=
AIVEN_SERVICE_NAME=

# Máximo tiempo de espera a que el servicio quede listo, en segundos.
AIVEN_ESPERA_MAXIMA_SEG=480

# --- Panel web -------------------------------------------------------------
# Cadena larga y aleatoria para firmar el JWT de sesión (cookie httponly)
# del panel en web/. Acepta cualquier carácter, incluidos símbolos.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
