# Igual que .gitignore: la imagen tampoco debe llevar datos reales,
# secretos, ni el entorno virtual local.
.venv/
venv/
.git/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

.env
.env.*
!.env.example

datos/entrada/*
datos/salida/*
!datos/entrada/.gitkeep
!datos/salida/.gitkeep

datos/entrada_usuarios/*
datos/salida_usuarios/*
!datos/entrada_usuarios/.gitkeep
!datos/salida_usuarios/.gitkeep

*.csv
*.xlsx
*.xlsm
*.xls
*.7z
*.zip
*.rar
*.tar.gz

excel/
docs/

.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
*.bak
*.tmp
